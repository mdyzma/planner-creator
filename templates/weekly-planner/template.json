  "sections": [
    {
      "id": "intro",
      "title": {
        "en": "Introduction",
        "pl": "Wprowadzenie"
      },
      "startOn": "right",
      "sheetAligned": true,
      "numbering": {
        "style": "roman"
      },
      "children": [
        {
          "page": "cover"
        },
        {
          "page": "year"
        }
      ]
    },
    {
      "id": "month",
      "title": {
        "en": "Month",
        "pl": "Miesiąc"
      },
      "repeat": {
        "over": "months"
      },
      "sheetAligned": true,
      "children": [
        {
          "page": "month-left"
        },
        {
          "page": "month-right"
        },
        {
          "id": "week",
          "title": {
            "en": "Week",
            "pl": "Tydzień"
          },
          "repeat": {
            "over": "weeksOfMonth"
          },
          "children": [
            {
              "page": "week-left"
            },
            {
              "page": "week-right"
            }
          ]
        },
        {
