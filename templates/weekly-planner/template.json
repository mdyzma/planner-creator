{
  "schemaVersion": 1,
  "id": "weekly-planner",
  "version": "1.0.0",
  "name": {
    "en": "Week by Week",
    "pl": "Tydzień po Tygodniu"
  },
  "description": {
    "en": "A simple weekly planner: a month spread with the calendar, goals and important dates, then a spread for each week with the days, three priorities and a to-do list.",
    "pl": "Prosty planer tygodniowy: rozkładówka miesiąca z kalendarzem, celami i ważnymi datami, potem rozkładówka każdego tygodnia z dniami, trzema priorytetami i listą zadań."
  },
  "supportedFormats": [
    "A4",
    "A5"
  ],
  "supportedLocales": [
    "en",
    "pl"
  ],
  "defaults": {
    "print": {
      "profile": "home-duplex",
      "margins": {
        "inner": 18,
        "outer": 14,
        "top": 14,
        "bottom": 17
      },
      "printerSafeMargin": 5,
      "outerRail": 0,
      "bleed": 0,
      "cropMarks": false,
      "binding": {
        "kind": "ring",
        "preset": "iso838-2hole",
        "holeCentreFromEdge": 12,
        "holeDiameter": 6,
        "holePositions": [
          108.5,
          188.5
        ],
        "punchGuides": false
      },
      "pageNumbers": true,
      "brandMark": true,
      "color": "color",
      "calibrationPage": false
    },
    "theme": {},
    "generation": {
      "durationMonths": 12,
      "monthMode": "calendar",
      "weekOwnership": "monday",
      "dailyLayout": "spread",
      "weeklyLayout": "spread",
      "quoteCadence": "none",
      "volumes": 1
    }
  },
  "pageTemplates": {
    "cover": {
      "id": "cover",
      "name": {
        "en": "Cover",
        "pl": "Strona tytułowa"
      },
      "hidePageNumber": true,
      "body": {
        "kind": "stack",
        "gap": 6,
        "children": [
          {
            "kind": "block",
            "block": {
              "id": "top",
              "type": "spacer",
              "props": {},
              "size": {
                "height": {
                  "fr": 1
                }
              }
            }
          },
          {
            "kind": "block",
            "block": {
              "id": "apple",
              "type": "image",
              "props": {
                "src": "data:image/svg+xml;base64,",
                "alt": {
                  "en": "An apple with a tick",
                  "pl": "Jabłko z ptaszkiem"
                }
              },
              "size": {
                "height": {
                  "fr": 2
                }
              }
            }
          },
          {
            "kind": "stack",
            "gap": 1,
            "children": [
              {
                "kind": "block",
                "block": {
                  "id": "title",
                  "type": "text",
                  "props": {
                    "text": {
                      "en": "Week by Week",
                      "pl": "Tydzień po Tygodniu"
                    },
                    "variant": "heading"
                  },
                  "size": {
                    "height": {
                      "mm": 10
                    }
                  }
                }
              },
              {
                "kind": "block",
                "block": {
                  "id": "subtitle",
                  "type": "text",
                  "props": {
                    "text": {
                      "en": "A planner for the weeks ahead",
                      "pl": "Planer na nadchodzące tygodnie"
                    },
                    "variant": "subheading"
                  },
                  "size": {
                    "height": {
                      "mm": 8
                    }
                  }
                }
              }
            ],
            "height": {
              "mm": 20
            }
          },
          {
            "kind": "block",
            "block": {
              "id": "gap",
              "type": "spacer",
              "props": {},
              "size": {
                "height": {
                  "fr": 1
                }
              }
            }
          },
          {
            "kind": "block",
            "block": {
              "id": "owner",
              "type": "writing-area",
              "props": {
                "title": {
                  "en": "This planner belongs to",
                  "pl": "Ten planer należy do"
                },
                "pattern": "lines",
                "pitch": 8
              },
              "size": {
                "height": {
                  "mm": 16
                }
              }
            }
          },
          {
            "kind": "stack",
            "gap": 1.5,
            "children": [
              {
                "kind": "block",
                "block": {
                  "id": "start",
                  "type": "text",
                  "props": {
                    "text": {
                      "en": "{{plannerStartDate}}",
                      "pl": "{{plannerStartDate}}"
                    },
                    "variant": "subheading"
                  }
                }
              }
            ],
            "height": {
              "mm": 16
            },
            "label": {
              "en": "I start on",
              "pl": "Zaczynam dnia"
            }
          },
          {
            "kind": "block",
            "block": {
              "id": "bottom",
              "type": "spacer",
              "props": {},
              "size": {
                "height": {
                  "fr": 1
                }
              }
            }
          }
        ]
      }
    },
    "year": {
      "id": "year",
      "name": {
        "en": "My year",
        "pl": "Mój rok"
      },
      "body": {
        "kind": "stack",
        "gap": 4,
        "children": [
          {
            "kind": "block",
            "block": {
              "id": "heading",
              "type": "text",
              "props": {
                "text": {
                  "en": "My year",
                  "pl": "Mój rok"
                },
                "variant": "heading"
              },
              "size": {
                "height": {
                  "mm": 12
                }
              }
            }
          },
          {
            "kind": "block",
            "block": {
              "id": "goals",
              "type": "numbered-list",
              "props": {
                "title": {
                  "en": "Goals for this year",
                  "pl": "Cele na ten rok"
                },
                "count": 5,
                "marker": "checkbox"
              },
              "size": {
                "height": {
                  "mm": 60
                }
              }
            }
          },
          {
            "kind": "block",
            "block": {
              "id": "remember",
              "type": "writing-area",
              "props": {
                "title": {
                  "en": "What I want to remember this year",
                  "pl": "O czym chcę pamiętać w tym roku"
                },
                "pattern": "lines",
                "framed": true
              },
              "size": {
                "height": {
                  "mm": 40
                }
              }
            }
          },
          {
            "kind": "block",
            "block": {
              "id": "notes",
              "type": "writing-area",
              "props": {
                "title": {
                  "en": "Notes",
                  "pl": "Notatki"
                },
                "pattern": "dots",
                "pitch": 5
              },
              "size": {
                "height": {
                  "fr": 1
                }
              }
            }
          }
        ]
      }
    },
    "month-left": {
      "id": "month-left",
      "name": {
        "en": "Month (left)",
        "pl": "Miesiąc (lewa)"
      },
      "spread": {
        "group": "month",
        "position": "left"
      },
      "body": {
        "kind": "stack",
        "gap": 4,
        "children": [
          {
            "kind": "block",
            "block": {
              "id": "month",
              "type": "text",
              "props": {
                "text": {
                  "en": "{{monthName}}",
                  "pl": "{{monthName}}"
                },
                "variant": "heading"
              },
              "size": {
                "height": {
                  "mm": 12
                }
              }
            }
          },
          {
            "kind": "block",
            "block": {
              "id": "calendar",
              "type": "calendar-grid",
              "props": {},
              "size": {
                "height": {
                  "fr": 3
                }
              }
            }
          },
          {
            "kind": "block",
            "block": {
              "id": "goals",
              "type": "numbered-list",
              "props": {
                "title": {
                  "en": "Goals for this month",
                  "pl": "Cele na ten miesiąc"
                },
                "count": 3,
                "marker": "checkbox"
              },
              "size": {
                "height": {
                  "fr": 1
                }
              }
            }
          }
        ]
      }
    },
    "month-right": {
      "id": "month-right",
      "name": {
        "en": "Month (right)",
        "pl": "Miesiąc (prawa)"
      },
      "spread": {
        "group": "month",
        "position": "right"
      },
      "body": {
        "kind": "stack",
        "gap": 4,
        "children": [
          {
            "kind": "block",
            "block": {
              "id": "dates",
              "type": "writing-area",
              "props": {
                "title": {
                  "en": "Important dates",
                  "pl": "Ważne daty"
                },
                "pattern": "lines",
                "framed": true
              },
              "size": {
                "height": {
                  "fr": 1
                }
              }
            }
          },
          {
            "kind": "block",
            "block": {
              "id": "todo",
              "type": "numbered-list",
              "props": {
                "title": {
                  "en": "To do this month",
                  "pl": "Do zrobienia w tym miesiącu"
                },
                "count": 8,
                "marker": "checkbox"
              },
              "size": {
                "height": {
                  "fr": 1
                }
              }
            }
          },
          {
            "kind": "block",
            "block": {
              "id": "notes",
              "type": "writing-area",
              "props": {
                "title": {
                  "en": "Notes",
                  "pl": "Notatki"
                },
                "pattern": "lines"
              },
              "size": {
                "height": {
                  "fr": 1
                }
              }
            }
          }
        ]
      },
      "formatOverrides": {
        "A5": [
          {
            "op": "add",
            "path": "/body/children/1/block/props/count",
            "value": 6
          }
        ]
      }
    },
    "week-left": {
      "id": "week-left",
      "name": {
        "en": "Week (left)",
        "pl": "Tydzień (lewa)"
      },
      "spread": {
        "group": "week",
        "position": "left"
      },
      "rationale": {
        "en": "Monday to Wednesday, with the three priorities of the week in the outer column, where they stay in view.",
        "pl": "Poniedziałek–środa, a trzy priorytety tygodnia w zewnętrznej kolumnie, gdzie są zawsze na widoku."
      },
      "outerRailWidth": 34,
      "outerRail": [
        {
          "id": "priorities",
          "type": "numbered-list",
          "props": {
            "title": {
              "en": "This week",
              "pl": "W tym tygodniu"
            },
            "count": 3,
            "marker": "checkbox"
          },
          "size": {
            "height": {
              "mm": 42
            }
          },
          "style": {
            "borderWidthPt": 0.3,
            "borderToken": "line",
            "radius": 1.5,
            "padding": 2.5
          }
        },
        {
          "id": "remember",
          "type": "writing-area",
          "props": {
            "title": {
              "en": "Remember",
              "pl": "Pamiętaj"
            },
            "pattern": "lines"
          },
          "size": {
            "height": {
              "fr": 1
            }
          }
        }
      ],
      "body": {
        "kind": "stack",
        "gap": 4,
        "children": [
          {
            "kind": "block",
            "block": {
              "id": "range",
              "type": "text",
              "props": {
                "text": {
                  "en": "Week {{weekRange}}",
                  "pl": "Tydzień {{weekRange}}"
                },
                "variant": "subheading"
              },
              "size": {
                "height": {
                  "mm": 8
                }
              }
            }
          },
          {
            "kind": "block",
            "block": {
              "id": "mon",
              "type": "day-strip",
              "props": {
                "weekday": 0,
                "markers": [],
                "lines": 4
              },
              "size": {
                "height": {
                  "fr": 1
                }
              }
            }
          },
          {
            "kind": "block",
            "block": {
              "id": "tue",
              "type": "day-strip",
              "props": {
                "weekday": 1,
                "markers": [],
                "lines": 4
              },
              "size": {
                "height": {
                  "fr": 1
                }
              }
            }
          },
          {
            "kind": "block",
            "block": {
              "id": "wed",
              "type": "day-strip",
              "props": {
                "weekday": 2,
                "markers": [],
                "lines": 4
              },
              "size": {
                "height": {
                  "fr": 1
                }
              }
            }
          }
        ]
      }
