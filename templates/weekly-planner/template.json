        "pl": "Notatki (kropki 5 mm)"
      },
      "body": {
        "kind": "stack",
        "gap": 4,
        "children": [
          {
            "kind": "block",
            "block": {
              "id": "notes",
              "type": "writing-area",
              "props": {
                "pattern": "dots",
