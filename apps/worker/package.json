{
  "name": "@planner/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker: serves the static site and renders PDFs with Browser Run (§8.3, M8).",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check:bundle": "wrangler deploy --dry-run --outdir dist",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "@planner/pdf": "workspace:*",
    "@planner/schema": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "@planner/template-therapeutic-recovery": "workspace:*",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1",
    "wrangler": "^4.137.0"
  }
}
